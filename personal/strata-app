#!/usr/bin/env bash
# Strata desktop app: the 0.2.11 window and runtime (unpacked in ~/Applications/strata-runtime) running the host and
# UI of the Spark fork (/home/spark/Apps/Strata/apps/host, symlinked). Rebuild the UI with `npm run build` in apps/host.
export STRATA_HARNESS_DIR=/home/spark/Applications/strata-runtime/squashfs-root/usr/lib/Strata/harness
# The one model this app uses (apps/host/server/pinned-model.mjs): started through its service when it does not answer.
export STRATA_PIN_BASE_URL=http://127.0.0.1:8082/v1
export STRATA_PIN_SERVICE=qwen-orca-iq4xs.service
export STRATA_PIN_NAME="Qwen3.8 Flash Next Uncensored"
# The image model of Image chats (apps/host/server/image-model.mjs): stable-diffusion.cpp's sd-server (built by
# tools/image/install.py into engine-image/) with Qwen-Image-2.1. Loading it stops the pinned model first.
export STRATA_IMAGE_SERVER=/home/spark/Apps/Strata/engine-image/sd-server
export STRATA_IMAGE_DIFFUSION=/home/spark/Apps/MODELS/qwen-image-2.1-F16-model.gguf
export STRATA_IMAGE_LLM=/home/spark/Apps/MODELS/Qwen-Image-2.1-encoder-Q8_0.gguf
export STRATA_IMAGE_VAE=/home/spark/Apps/MODELS/qwen_image_2.1_vae_bf16.safetensors
export STRATA_IMAGE_NAME="Qwen-Image-2.1"
# Editing pictures needs the text encoder's vision part; LoRAs made for Qwen-Image-2.1, each with a .strata.json note.
export STRATA_IMAGE_VISION=/home/spark/Apps/MODELS/mmproj-Qwen3VL-8B-Instruct-F16.gguf
export STRATA_IMAGE_LORA_DIR=/home/spark/Apps/MODELS/loras/qwen-image-2.1
# Remote access (apps/host/server/remote-access.mjs): the whole app over HTTPS on port 8443, LAN and outside
# (https://sprinkler.sparknv.win:8443 through Cloudflare), behind the key in this file. Remove the line to turn it off.
export STRATA_REMOTE_CONFIG=/home/spark/.config/strata-remote/remote.json
exec /home/spark/Applications/strata-runtime/squashfs-root/AppRun "$@"
